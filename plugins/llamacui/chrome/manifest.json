{
  "manifest_version": 3,
  "name": "Llama.cui",
  "version": "1.0.0",
  "description": "Chat with your local llama.cui model from any browser tab",

  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "audioCapture",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.com/*",
        "https://web.outlook.com/*",
        "https://outlook.office365.com/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["browser-polyfill.js", "context_menu.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "omnibox": { "keyword": "c" },

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png"
  },

  "action": {
    "default_title": "Llama.cui",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "background": {
    "service_worker": "service_worker.js"
  }
}
