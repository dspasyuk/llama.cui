{
  "manifest_version": 2,
  "name": "Llama.cui",
  "version": "1.0.0",
  "description": "Chat with your local llama.cui model from any browser tab",

  "browser_specific_settings": {
    "gecko": {
      "id": "llamacui@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.com/*",
        "https://web.outlook.com/*",
        "https://outlook.office365.com/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["browser-polyfill.js", "context_menu.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "omnibox": { "keyword": "c" },

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "64": "icon-64.svg"
  },

  "browser_action": {
    "default_title": "Llama.cui",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },

  "sidebar_action": {
    "default_title": "Llama.cui",
    "default_panel": "floating.html",
    "default_icon": "icon.svg"
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  }
}
